# Copy to .env (git-ignored) and choose a local password.
POSTGRES_USER=poker_coach
POSTGRES_PASSWORD=change-me-locally
# Host port of the local database (container port stays 5432).
POSTGRES_PORT=5432
# Only for `docker compose --profile app` (the production image locally). Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=
