# Copy to app.env next to compose.yml, then: chmod 600 app.env. Secrets: never commit the real file.
# Names are ASP.NET Core configuration keys (":" written "__").

# Managed PostgreSQL over the private network (Scaleway console → database → private endpoint).
# Encrypted; certificate verification can be added with the CA from the console (SSL Mode=VerifyFull;Root Certificate=…).
ConnectionStrings__PokerCoach=Host=<private-ip>;Port=5432;Database=poker_coach;Username=poker_coach;Password=<password>;SSL Mode=Require

Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

Coaching__Anthropic__ApiKey=
Coaching__MonthlyBudgetUsd=20

Email__BrevoApiKey=
Email__FromAddress=no-reply@nutsiq.com

# Stripe live mode (docs/runbooks/stripe-setup.md): restricted key.
Billing__Stripe__SecretKey=
Billing__Stripe__WebhookSecret=
Billing__Stripe__Prices__Pro__Monthly=
Billing__Stripe__Prices__Pro__Yearly=
Billing__Stripe__Prices__Elite__Monthly=
Billing__Stripe__Prices__Elite__Yearly=

Admin__Emails__0=charlesikeng@gmail.com
