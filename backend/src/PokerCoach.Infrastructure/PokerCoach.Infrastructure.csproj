  <ItemGroup>
    <InternalsVisibleTo Include="PokerCoach.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PokerCoach.Application\PokerCoach.Application.csproj" />
  </ItemGroup>
</Project>
