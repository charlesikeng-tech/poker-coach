root = false

[*.cs]
# Primary constructors and file-scoped namespaces are the house style.
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

[tests/**.cs]
# Test names read as sentences.
dotnet_diagnostic.CA1707.severity = none
# xunit v3 test projects are executables; public test types are required by the framework.
dotnet_diagnostic.CA1515.severity = none

[src/PokerCoach.Infrastructure/Persistence/Migrations/**.cs]
# Generated by `dotnet ef migrations add`: never hand-edited, so style rules do not apply.
generated_code = true
