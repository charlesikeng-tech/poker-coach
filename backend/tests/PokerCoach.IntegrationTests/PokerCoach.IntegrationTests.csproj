<Project Sdk="Microsoft.NET.Sdk">
  <!-- Real PostgreSQL in a throwaway container (Docker required): constraints, SQL and concurrency. -->
  <PropertyGroup>
    <!-- xunit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PokerCoach.Infrastructure\PokerCoach.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests share one database and the import queue: run them one at a time. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PokerCoach.HandHistories.Tests\GoldenFiles\**\*" LinkBase="GoldenFiles" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
